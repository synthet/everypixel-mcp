# Environment variable contract — Everypixel MCP
#
# Copy to `.env` (git-ignored) and fill in real values. Never commit `.env` or paste
# real values into prompts, logs, or tool arguments (see .agent/SAFETY.md).

# Preferred HTTP Basic Auth credentials from https://labs.everypixel.com/account/keys
EVERYPIXEL_CLIENT_ID=<your-everypixel-client-id>
EVERYPIXEL_CLIENT_SECRET=<your-everypixel-client-secret>

# Optional OAuth 2.0 Bearer access token (used if Client ID/Secret are unset; do NOT use Client Secret here)
# EVERYPIXEL_ACCESS_TOKEN=<oauth-access-token>

# Production API base URL
EVERYPIXEL_BASE_URL=https://api.everypixel.com/v1

# HTTP timeout for Everypixel API calls
EVERYPIXEL_TIMEOUT_SECONDS=60

# Optional: absolute path to another .env (used only for keys missing from process/.env)
# EVERYPIXEL_ENV_FILE=D:\Projects\everypixel-mcp\.env

# Optional allowed local media directories (; on Windows, : elsewhere).
# Local file paths are disabled when unset. Each request also requires allow_local_files=true.
# EVERYPIXEL_MEDIA_ROOTS=D:\path\to\prepared-media
